EXPO_PUBLIC_SUPABASE_URL=<your-supabase-url>
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Finexer Open Banking (replaces TrueLayer)
FINEXER_API_KEY=<your-finexer-api-key>

# Server-side Supabase (service role for writing bank_data)
SUPABASE_URL=<your-supabase-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Required for AI-powered transaction classification (Layer 3).
# Without this, unknown merchants (niche restaurants, SaaS tools, etc.)
# will stay categorised as "Other". Get your key at https://console.anthropic.com
CLAUDE_API_KEY=<your-claude-api-key>

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=Bocy <notifications@updates.bocy.io>

# Cron job authentication (generate a random string, set in Vercel env vars)
CRON_SECRET=<generate-a-random-secret>

# App URL for email links
APP_URL=<your-app-url>

# ElevenLabs TTS — voice responses in chat (https://elevenlabs.io)
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
# Optional: override default voice/model (defaults: Rachel voice, eleven_multilingual_v2)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# GIPHY API key for reaction GIFs in chat (https://developers.giphy.com)
GIPHY_API_KEY=<your-giphy-api-key>

# Web Push Notifications (VAPID keys — generate with: npx web-push generate-vapid-keys)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:notifications@updates.bocy.io

# Stripe (web subscriptions — https://dashboard.stripe.com)
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PRICE_MONTHLY=<your-stripe-monthly-price-id>
STRIPE_PRICE_YEARLY=<your-stripe-yearly-price-id>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

# Sentry error tracking (https://sentry.io)
EXPO_PUBLIC_SENTRY_DSN=<your-sentry-dsn>
SENTRY_DSN=<your-sentry-dsn>

# EAS Build & App Store submission
# Get your project ID from https://expo.dev after running `eas init`
EAS_PROJECT_ID=<your-eas-project-id>
# Apple credentials (for App Store submission via EAS Submit)
APPLE_ID=<your-apple-id-email>
ASC_APP_ID=<your-app-store-connect-app-id>
APPLE_TEAM_ID=<your-apple-team-id>
# Set EXPO_TOKEN in GitHub Secrets for CI/CD (https://expo.dev/accounts/[account]/settings/access-tokens)
EXPO_TOKEN=<your-expo-access-token>
